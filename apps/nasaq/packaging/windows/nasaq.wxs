<?xml version="1.0" encoding="utf-8"?>
<!--
  Nasaq MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build nasaq.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.retoush` owned by Nasaq,
  and Nasaq offered under "Open with" for PSD/PSB and the image formats it reads (without
  taking over the user's default app for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Nasaq"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="49E87D30-BB68-4896-AA1D-F45C833CFC3C"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Nasaq page layout and publishing" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Nasaq is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="NasaqIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NasaqIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://malshatti.com/apps/nasaq.html" />
    <Property Id="ARPURLUPDATEINFO" Value="https://malshatti.com/apps/nasaq.html" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/warsha" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Nasaq" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Nasaq" Level="1">
      <ComponentGroupRef Id="NasaqFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="NasaqFiles" Directory="INSTALLFOLDER">
      <Component Id="NasaqApp" Guid="DE018EF3-EE87-4E36-9F76-0B7B060A195E">
        <File Id="NasaqExe" Source="$(var.BinDir)\nasaq.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Nasaq"
              Description="Nasaq page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NasaqIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\nasaq.exe" Value="[#NasaqExe]" Type="string" />
      </Component>

      <Component Id="NasaqCli">
        <File Id="NasaqCliExe" Source="$(var.BinDir)\nasaq-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
