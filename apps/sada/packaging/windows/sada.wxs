<?xml version="1.0" encoding="utf-8"?>
<!--
  Sada MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build sada.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.sada` sessions owned by
  Sada, and Sada offered under "Open with" for WAV/AIFF/FLAC/MP3 and MIDI files
  (without taking over the user's default player for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Sada"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="EE53D3E5-D0AE-40F9-808D-9417FDEBF61A"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Sada digital audio workstation" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Sada is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="SadaIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SadaIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://malshatti.com/apps/sada.html" />
    <Property Id="ARPURLUPDATEINFO" Value="https://malshatti.com/apps/sada.html" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/warsha" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Sada" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Sada" Level="1">
      <ComponentGroupRef Id="SadaFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="SadaFiles" Directory="INSTALLFOLDER">
      <Component Id="SadaApp" Guid="091136D7-205E-41A8-9D27-5E231F7CBBD4">
        <File Id="SadaExe" Source="$(var.BinDir)\sada.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Sada"
              Description="Sada digital audio workstation" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="SadaIcon.ico" IconIndex="0" />
        </File>

        <!-- .sada: Sada's own session format; Sada is its default app. -->
        <ProgId Id="Sada.Session" Description="Sada Session" Icon="SadaExe" IconIndex="0">
          <Extension Id="sada" ContentType="application/x-sada-session">
            <Verb Id="open" Command="Open" TargetFile="SadaExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Audio and MIDI files: offered under "Open with" (imported into a session), never forced
             as the default. -->
        <ProgId Id="Sada.Audio" Description="Audio File" Icon="SadaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sada.Audio\shell\open\command" Value="&quot;[#SadaExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="Sada.Midi" Description="MIDI File" Icon="SadaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sada.Midi\shell\open\command" Value="&quot;[#SadaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.wav\OpenWithProgids" Name="Sada.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aif\OpenWithProgids" Name="Sada.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aiff\OpenWithProgids" Name="Sada.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.flac\OpenWithProgids" Name="Sada.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mp3\OpenWithProgids" Name="Sada.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mid\OpenWithProgids" Name="Sada.Midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.midi\OpenWithProgids" Name="Sada.Midi" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "sada"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sada.exe" Name="FriendlyAppName" Value="Sada" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sada.exe\shell\open\command" Value="&quot;[#SadaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sada.exe\SupportedTypes" Name=".sada" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sada.exe\SupportedTypes" Name=".wav" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sada.exe\SupportedTypes" Name=".aif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sada.exe\SupportedTypes" Name=".aiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sada.exe\SupportedTypes" Name=".flac" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sada.exe\SupportedTypes" Name=".mp3" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sada.exe\SupportedTypes" Name=".mid" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\sada.exe\SupportedTypes" Name=".midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\sada.exe" Value="[#SadaExe]" Type="string" />
      </Component>

      <Component Id="SadaCli" Guid="4552049A-C2F0-4AB0-BAE6-A62C3348F4B4">
        <File Id="SadaCliExe" Source="$(var.BinDir)\sada-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
