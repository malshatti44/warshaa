<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definition for Sada's session format. Audio and MIDI types come from
     the system database. Installed to /usr/share/mime/packages/ (update-mime-database runs on
     install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-sada-session">
    <comment>Sada session</comment>
    <sub-class-of type="application/json"/>
    <icon name="com.malshatti.sada"/>
    <glob pattern="*.sada"/>
  </mime-type>
</mime-info>
