<?xml version="1.0" encoding="utf-8"?>
<!--
  Minbar MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build minbar.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.minbar` owned by
  Minbar, and Minbar offered under "Open with" for .pptx/.potx/.ppsx (without taking over
  the user's default app for them).

  UpgradeCode is fixed for Minbar forever (playbook §6); never change it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Minbar"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="6F9C69E7-7825-40D2-BF26-C274DA676425"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Minbar presentations and slide shows" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Minbar is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="MinbarIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="MinbarIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://malshatti.com/apps/minbar.html" />
    <Property Id="ARPURLUPDATEINFO" Value="https://malshatti.com/apps/minbar.html" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/warsha" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Minbar" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Minbar" Level="1">
      <ComponentGroupRef Id="MinbarFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="MinbarFiles" Directory="INSTALLFOLDER">
      <Component Id="MinbarApp" Guid="D87EA444-41A4-4C19-922E-66D1A29461FF">
        <File Id="MinbarExe" Source="$(var.BinDir)\minbar.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Minbar"
              Description="Minbar presentations and slide shows" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="MinbarIcon.ico" IconIndex="0" />
        </File>

        <!-- .minbar: Minbar's own format. -->
        <ProgId Id="Minbar.Presentation" Description="Minbar Presentation" Icon="MinbarExe" IconIndex="0">
          <Extension Id="minbar" ContentType="application/x-minbar">
            <Verb Id="open" Command="Open" TargetFile="MinbarExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- "Open with" for PowerPoint formats, without becoming the default. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\minbar.exe" Name="FriendlyAppName" Value="Minbar" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\minbar.exe\shell\open\command" Value="&quot;[#MinbarExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\minbar.exe\SupportedTypes" Name=".minbar" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\minbar.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\minbar.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\minbar.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pptx\OpenWithProgids" Name="Minbar.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.potx\OpenWithProgids" Name="Minbar.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ppsx\OpenWithProgids" Name="Minbar.Presentation" Value="" Type="string" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\minbar.exe" Value="[#MinbarExe]" Type="string" />
      </Component>

      <Component Id="MinbarCli">
        <File Id="MinbarCliExe" Source="$(var.BinDir)\minbar-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
