<?xml version="1.0" encoding="utf-8"?>
<!--
  Monteer MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build monteer.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Monteer"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="31E6FB14-9DBC-41DD-B24B-26B71FB31B62"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Monteer video editor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Monteer is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="MonteerIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="MonteerIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://malshatti.com/apps/monteer.html" />
    <Property Id="ARPURLUPDATEINFO" Value="https://malshatti.com/apps/monteer.html" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/warsha" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Monteer" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Monteer" Level="1">
      <ComponentGroupRef Id="MonteerFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="MonteerFiles" Directory="INSTALLFOLDER">
      <Component Id="MonteerApp" Guid="15933017-925B-4963-8992-52000EB26AAA">
        <File Id="MonteerExe" Source="$(var.BinDir)\monteer.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Monteer"
              Description="Monteer video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="MonteerIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\monteer.exe" Value="[#MonteerExe]" Type="string" />
      </Component>

      <Component Id="MonteerCli">
        <File Id="MonteerCliExe" Source="$(var.BinDir)\monteer-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
