<?xml version="1.0" encoding="utf-8"?>
<!--
  Satr MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build satr.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  UpgradeCode and the component GUIDs below belong to Satr alone. Never copy them from (or
  into) a sibling Warsha app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Satr"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="075497F9-E861-45D0-9C7F-A74F8C34E6BA"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Satr word processor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Satr is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="SatrIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SatrIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://malshatti.com/apps/satr.html" />
    <Property Id="ARPURLUPDATEINFO" Value="https://malshatti.com/apps/satr.html" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/warsha" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch Satr (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Satr" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#SatrExe]" />
    <CustomAction Id="LaunchSatr" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSatr"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Satr" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Satr" Level="1">
      <ComponentGroupRef Id="SatrFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="SatrFiles" Directory="INSTALLFOLDER">
      <Component Id="SatrApp" Guid="855DCEC6-9285-444F-9382-9654B83B34F6">
        <File Id="SatrExe" Source="$(var.BinDir)\satr.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Satr"
              Description="Satr word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="SatrIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\satr.exe" Value="[#SatrExe]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a Satr ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so Satr shows in
           Explorer's "Open with". The Word, RTF and ODT types are also Satr's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="SatrFileTypes" Guid="EFF89E6A-F9B8-49F9-B3AE-E243347484B4">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Satr" Value="Software\Satr\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities" Name="ApplicationName" Value="Satr" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities" Name="ApplicationIcon" Value="&quot;[#SatrExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe" Name="FriendlyAppName" Value="Satr" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="Satr.Document" Description="Word Document" Icon="SatrExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Satr.Document\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docx\OpenWithProgids" Name="Satr.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities\FileAssociations" Name=".docx" Value="Satr.Document" Type="string" />

        <ProgId Id="Satr.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="SatrExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Satr.DocumentMacroEnabled\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docm\OpenWithProgids" Name="Satr.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities\FileAssociations" Name=".docm" Value="Satr.DocumentMacroEnabled" Type="string" />

        <ProgId Id="Satr.Template" Description="Word Template" Icon="SatrExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Satr.Template\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotx\OpenWithProgids" Name="Satr.Template" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities\FileAssociations" Name=".dotx" Value="Satr.Template" Type="string" />

        <ProgId Id="Satr.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="SatrExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Satr.TemplateMacroEnabled\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotm\OpenWithProgids" Name="Satr.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities\FileAssociations" Name=".dotm" Value="Satr.TemplateMacroEnabled" Type="string" />

        <ProgId Id="Satr.LegacyDocument" Description="Legacy Word Document" Icon="SatrExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Satr.LegacyDocument\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.doc\OpenWithProgids" Name="Satr.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities\FileAssociations" Name=".doc" Value="Satr.LegacyDocument" Type="string" />

        <ProgId Id="Satr.LegacyTemplate" Description="Legacy Word Template" Icon="SatrExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Satr.LegacyTemplate\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dot\OpenWithProgids" Name="Satr.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities\FileAssociations" Name=".dot" Value="Satr.LegacyTemplate" Type="string" />

        <ProgId Id="Satr.RichText" Description="Rich Text Document" Icon="SatrExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Satr.RichText\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.rtf\OpenWithProgids" Name="Satr.RichText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities\FileAssociations" Name=".rtf" Value="Satr.RichText" Type="string" />

        <ProgId Id="Satr.OpenDocumentText" Description="OpenDocument Text" Icon="SatrExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Satr.OpenDocumentText\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.odt\OpenWithProgids" Name="Satr.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Satr\Capabilities\FileAssociations" Name=".odt" Value="Satr.OpenDocumentText" Type="string" />

        <ProgId Id="Satr.Markdown" Description="Markdown Document" Icon="SatrExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Satr.Markdown\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="Satr.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="Satr.PlainText" Description="Text Document" Icon="SatrExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Satr.PlainText\shell\open\command" Value="&quot;[#SatrExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="Satr.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\satr.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="SatrCli">
        <File Id="SatrCliExe" Source="$(var.BinDir)\satr-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
