[Desktop Entry]
Type=Application
Name=Satr
GenericName=Word Processor
Comment=Write and design documents; open and save Word files
Exec=satr %F
TryExec=satr
Icon=com.malshatti.satr
Terminal=false
StartupNotify=true
StartupWMClass=com.malshatti.satr
Categories=Office;WordProcessor;
Keywords=word;processor;document;docx;writer;text;letter;report;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.ms-word.document.macroEnabled.12;application/vnd.openxmlformats-officedocument.wordprocessingml.template;application/vnd.ms-word.template.macroEnabled.12;application/msword;application/msword-template;application/vnd.oasis.opendocument.text;application/rtf;text/rtf;text/markdown;text/x-tex;text/html;text/plain;
